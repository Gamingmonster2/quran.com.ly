    command_line: "node -e \'\nasync function test() {\n  const res = await fetch(\"https://raw.githubusercontent.com/fawazahmed0/quran-api/master/fonts.min.json\");\n  const data = await res.json();\n  for (const k in data) {\n    if (k.toLowerCase().includes(\"taha\") || k.toLowerCase().includes(\"naskh\") || data[k].font?.toLowerCase().includes(\"taha\") || data[k].font?.toLowerCase().includes(\"naskh\")) {\n      console.log(k, data[k].name, data[k].font, data[k].ttf || data[k].original);\n    }\n  }\n}\ntest();\n\'"
