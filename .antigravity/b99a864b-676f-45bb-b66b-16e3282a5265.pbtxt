  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { Play, Pause, Copy, Check, Bookmark, BookmarkCheck } from \'lucide-react\';\nimport { Ayah } from \'../types/quran.ts\';\nimport { toArabicDigits, copyVerseToClipboard } from \'../utils/quranHelpers.ts\';\n\ninterface VerseCardProps {\n  ayah: Ayah;\n  surahName: string;\n  fontSize: number;\n  isPlaying: boolean;\n  isBookmarked: boolean;\n  onPlayAudio: (ayah: Ayah) => void;\n  onToggleBookmark: (ayah: Ayah) => void;\n}\n\nexport const VerseCard: React.FC<VerseCardProps> = ({\n  ayah,\n  surahName,\n  fontSize,\n  isPlaying,\n  isBookmarked,\n  onPlayAudio,\n  onToggleBookmark,\n}) => {\n  const [copied, setCopied] = useState(false);\n\n  const handleCopy = async () => {\n    const success = await copyVerseToClipboard(ayah.text, surahName, ayah.aya);\n    if (success) {\n      setCopied(true);\n      setTimeout(() => setCopied(false), 2000);\n    }\n  };\n\n  return (\n    <div\n      id={`ayah-${ayah.sura}-${ayah.aya}`}\n      className={`p-5 sm:p-6 rounded-xl border transition-all ${\n        isPlaying\n          ? \'bg-amber-50/60 border-amber-300 shadow-sm\'\n          : \'bg-white border-stone-200/80 hover:border-stone-300 shadow-xs\'\n      }`}\n    >\n      {/* Top verse metadata & action strip */}\n      <div className=\"flex items-center justify-between pb-3 mb-4 border-b border-stone-100 text-xs text-stone-500 font-sans\">\n        <div className=\"flex items-center gap-2\">\n          <span className=\"font-semibold text-stone-800\">\n            \330\263\331\210\330\261\330\251 {surahName}\n          </span>\n          <span aria-hidden=\"true\">\302\267</span>\n          <span>\330\247\331\204\330\242\331\212\330\251 {toArabicDigits(ayah.aya)}</span>\n          <span aria-hidden=\"true\">\302\267</span>\n          <span className=\"font-mono text-stone-400\">\n            {ayah.sura}:{ayah.aya}\n          </span>\n        </div>\n\n        {/* Action icons */}\n        <div className=\"flex items-center gap-1\">\n          <button\n            onClick={() => onPlayAudio(ayah)}\n            title={isPlaying ? \'\330\245\331\212\331\202\330\247\331\201 \330\247\331\204\330\252\331\204\330\247\331\210\330\251\' : \'\330\247\330\263\330\252\331\205\330\247\330\271 \331\204\331\204\330\252\331\204\330\247\331\210\330\251\'}\n            className={`p-1.5 rounded-lg transition-colors ${\n              isPlaying\n                ? \'bg-amber-600 text-white\'\n                : \'text-stone-600 hover:text-stone-900 hover:bg-stone-100\'\n            }`}\n          >\n            {isPlaying ? (\n              <Pause className=\"w-4 h-4\" />\n            ) : (\n              <Play className=\"w-4 h-4\" />\n            )}\n          </button>\n\n          <button\n            onClick={handleCopy}\n            title=\"\331\206\330\263\330\256 \330\247\331\204\330\242\331\212\330\251 \330\247\331\204\331\203\330\261\331\212\331\205\330\251\"\n            className=\"p-1.5 rounded-lg text-stone-600 hover:text-stone-900 hover:bg-stone-100 transition-colors\"\n          >\n            {copied ? (\n              <Check className=\"w-4 h-4 text-emerald-600\" />\n            ) : (\n              <Copy className=\"w-4 h-4\" />\n            )}\n          </button>\n\n          <button\n            onClick={() => onToggleBookmark(ayah)}\n            title={isBookmarked ? \'\330\245\330\262\330\247\331\204\330\251 \331\205\331\206 \330\247\331\204\331\205\330\255\331\201\331\210\330\270\330\247\330\252\' : \'\330\255\331\201\330\270 \330\247\331\204\330\242\331\212\330\251\'}\n            className={`p-1.5 rounded-lg transition-colors ${\n              isBookmarked\n                ? \'text-amber-600 bg-amber-50\'\n                : \'text-stone-600 hover:text-stone-900 hover:bg-stone-100\'\n            }`}\n          >\n            {isBookmarked ? (\n              <BookmarkCheck className=\"w-4 h-4 fill-amber-600 text-amber-600\" />\n            ) : (\n              <Bookmark className=\"w-4 h-4\" />\n            )}\n          </button>\n        </div>\n      </div>\n\n      {/* Quranic Uthmani Text */}\n      <div\n        className=\"font-quran leading-loose text-stone-900 text-right text-balance\"\n        style={{ fontSize: `${fontSize}px`, lineHeight: 2.2 }}\n      >\n        {ayah.text}\n        <span className=\"inline-flex items-center justify-center font-amiri text-stone-500 mx-2 text-sm select-none border border-stone-300 rounded-full w-7 h-7 align-middle bg-stone-50\">\n          {toArabicDigits(ayah.aya)}\n        </span>\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/VerseCard.tsx"
        }
        overwrite: true
      }
    }
