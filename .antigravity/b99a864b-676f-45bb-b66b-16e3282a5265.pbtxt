  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { Download, FileJson, Copy, Check, ExternalLink, Code2, Database } from \'lucide-react\';\nimport { Ayah, SurahMeta } from \'../types/quran.ts\';\n\ninterface DataInspectorProps {\n  allVerses: Ayah[];\n  surahs: SurahMeta[];\n  onClose?: () => void;\n  isModal?: boolean;\n}\n\nexport const DataInspectorModal: React.FC<DataInspectorProps> = ({\n  allVerses,\n  surahs,\n  onClose,\n  isModal = false,\n}) => {\n  const [activeTab, setActiveTab] = useState<\'preview\' | \'schema\' | \'code\'>(\'preview\');\n  const [copiedCode, setCopiedCode] = useState(false);\n  const [codeLang, setCodeLang] = useState<\'javascript\' | \'python\' | \'curl\'>(\'javascript\');\n\n  const sampleVerses = allVerses.slice(0, 7);\n\n  const downloadFile = (url: string, filename: string) => {\n    const link = document.createElement(\'a\');\n    link.href = url;\n    link.download = filename;\n    document.body.appendChild(link);\n    link.click();\n    document.body.removeChild(link);\n  };\n\n  const codeSnippets: Record<string, string> = {\n    javascript: `// \330\247\330\263\330\252\331\212\330\261\330\247\330\257 \331\210\331\202\330\261\330\247\330\241\330\251 \331\205\331\204\331\201 \330\247\331\204\331\202\330\261\330\242\331\206 \330\247\331\204\331\203\330\261\331\212\331\205 \331\201\331\212 Node.js / TypeScript\nimport fs from \'node:fs\';\n\ninterface Ayah {\n  sura: number; // 1 - 114\n  aya: number;  // 1 - n\n  text: string; // \330\247\331\204\330\261\330\263\331\205 \330\247\331\204\330\271\330\253\331\205\330\247\331\206\331\212\n}\n\nconst quranData: Ayah[] = JSON.parse(\n  fs.readFileSync(\'./assets/data/quran.json\', \'utf-8\')\n);\n\nconsole.log(\\`\330\245\330\254\331\205\330\247\331\204\331\212 \330\247\331\204\330\242\331\212\330\247\330\252: \\${quranData.length}\\`); // 6236\nconst firstAyah = quranData[0];\nconsole.log(firstAyah.text); // \330\250\331\220\330\263\333\241\331\205\331\220 \331\261\331\204\331\204\331\221\331\216\331\207\331\220 \331\261\331\204\330\261\331\221\331\216\330\255\333\241\331\205\331\216\331\260\331\206\331\220 \331\261\331\204\330\261\331\221\331\216\330\255\331\220\331\212\331\205\331\220`,\n\n    python: `# \331\202\330\261\330\247\330\241\330\251 \331\205\331\204\331\201 \330\247\331\204\331\202\330\261\330\242\331\206 \330\247\331\204\331\203\330\261\331\212\331\205 \331\201\331\212 Python\nimport json\n\nwith open(\'./assets/data/quran.json\', \'r\', encoding=\'utf-8\') as f:\n    quran = json.load(f)\n\nprint(f\"\330\245\330\254\331\205\330\247\331\204\331\212 \330\247\331\204\330\242\331\212\330\247\330\252: {len(quran)}\") # 6236\n# \330\252\330\265\331\201\331\212\330\251 \330\242\331\212\330\247\330\252 \330\263\331\210\330\261\330\251 \330\247\331\204\330\245\330\256\331\204\330\247\330\265 (\330\261\331\202\331\205 112)\nikhlas_ayahs = [v for v in quran if v[\'sura\'] == 112]\nfor ayah in ikhlas_ayahs:\n    print(f\"{ayah[\'aya\']}: {ayah[\'text\']}\")`,\n\n    curl: `# \330\252\331\206\330\262\331\212\331\204 \331\205\331\204\331\201 \330\247\331\204\331\202\330\261\330\242\331\206 \330\247\331\204\331\203\330\261\331\212\331\205 \330\247\331\204\330\264\330\247\331\205\331\204 \331\205\330\250\330\247\330\264\330\261\330\251\ncurl -O https://cdn.jsdelivr.net/npm/quran-json@3.1.2/dist/quran.json\n\n# \330\243\331\210 \330\247\331\204\331\210\330\265\331\210\331\204 \331\204\331\204\331\205\331\204\331\201 \330\247\331\204\331\205\330\255\331\204\331\212 \331\205\331\206 \331\205\330\263\330\247\330\261 \330\247\331\204\330\252\330\267\330\250\331\212\331\202:\n# assets/data/quran.json`\n  };\n\n  const handleCopyCode = async () => {\n    await navigator.clipboard.writeText(codeSnippets[codeLang]);\n    setCopiedCode(true);\n    setTimeout(() => setCopiedCode(false), 2000);\n  };\n\n  const content = (\n    <div className=\"space-y-6 text-right\">\n      {/* Title & Stats */}\n      <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-4 border-b border-stone-200\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"w-12 h-12 rounded-xl bg-stone-900 text-white flex items-center justify-center shrink-0\">\n            <Database className=\"w-6 h-6\" />\n          </div>\n          <div>\n            <h2 className=\"text-xl sm:text-2xl font-bold font-quran text-stone-900\">\n              \331\205\330\263\330\252\331\210\330\257\330\271 \330\250\331\212\330\247\331\206\330\247\330\252 \330\247\331\204\331\202\330\261\330\242\331\206 \330\247\331\204\331\203\330\261\331\212\331\205 (quran.json)\n            </h2>\n            <p className=\"text-xs text-stone-500 font-sans mt-0.5\">\n              \330\250\331\212\330\247\331\206\330\247\330\252 \331\205\331\201\330\252\331\210\330\255\330\251 \330\247\331\204\331\205\330\265\330\257\330\261 \330\250\330\247\331\204\330\261\330\263\331\205 \330\247\331\204\330\271\330\253\331\205\330\247\331\206\331\212 \330\247\331\204\330\252\330\247\331\205 (Hafs Uthmani Script)\n            </p>\n          </div>\n        </div>\n\n        {/* Download Buttons Strip */}\n        <div className=\"flex flex-wrap items-center gap-2\">\n          <button\n            onClick={() => downloadFile(\'/assets/data/quran.json\', \'quran.json\')}\n            className=\"inline-flex items-center gap-2 px-3.5 py-2 text-xs font-semibold text-white bg-stone-900 hover:bg-stone-800 rounded-lg transition-colors shadow-xs\"\n          >\n            <Download className=\"w-3.5 h-3.5\" />\n            <span>\330\252\331\206\330\262\331\212\331\204 quran.json (\331\241.\331\246 \331\205\331\212\330\272\330\247\330\250\330\247\331\212\330\252)</span>\n          </button>\n          <button\n            onClick={() =>\n              downloadFile(\'/assets/data/quran-by-surah.json\', \'quran-by-surah.json\')\n            }\n            className=\"inline-flex items-center gap-2 px-3 py-2 text-xs font-medium text-stone-700 bg-white border border-stone-200 hover:bg-stone-50 rounded-lg transition-colors shadow-2xs\"\n          >\n            <FileJson className=\"w-3.5 h-3.5 text-stone-500\" />\n            <span>\331\205\331\202\330\263\331\205 \330\255\330\263\330\250 \330\247\331\204\330\263\331\210\330\261</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Dataset Specs Summary */}\n      <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs font-sans\">\n        <div className=\"p-3 rounded-xl bg-stone-50 border border-stone-200/80\">\n          <div className=\"text-stone-400\">\330\271\330\257\330\257 \330\247\331\204\330\263\331\210\330\261 \330\247\331\204\331\203\331\204\331\212</div>\n          <div className=\"text-lg font-bold font-mono text-stone-900 mt-1\">\n            {surahs.length || 114}\n          </div>\n        </div>\n        <div className=\"p-3 rounded-xl bg-stone-50 border border-stone-200/80\">\n          <div className=\"text-stone-400\">\330\245\330\254\331\205\330\247\331\204\331\212 \330\247\331\204\330\242\331\212\330\247\330\252</div>\n          <div className=\"text-lg font-bold font-mono text-stone-900 mt-1\">\n            {allVerses.length || 6236}\n          </div>\n        </div>\n        <div className=\"p-3 rounded-xl bg-stone-50 border border-stone-200/80\">\n          <div className=\"text-stone-400\">\330\247\331\204\330\261\330\263\331\205 \331\210\330\247\331\204\330\256\330\267</div>\n          <div className=\"text-lg font-bold text-stone-900 mt-1\">\n            \330\271\330\253\331\205\330\247\331\206\331\212 \331\205\330\264\331\203\331\210\331\204\n          </div>\n        </div>\n        <div className=\"p-3 rounded-xl bg-stone-50 border border-stone-200/80\">\n          <div className=\"text-stone-400\">\331\205\330\263\330\247\330\261 \330\247\331\204\331\205\331\204\331\201 \331\201\331\212 \330\247\331\204\331\205\330\264\330\261\331\210\330\271</div>\n          <div 