        target_content: "import { Ayah, QuranFontChoice } from \'../types/quran.ts\';\nimport { toArabicDigits, copyVerseToClipboard } from \'../utils/quranHelpers.ts\';\n\ninterface VerseCardProps {\n  ayah: Ayah;\n  surahName: string;\n  fontSize: number;\n  fontChoice?: QuranFontChoice;\n  isPlaying: boolean;\n  isBookmarked: boolean;\n  onPlayAudio: (ayah: Ayah) => void;\n  onToggleBookmark: (ayah: Ayah) => void;\n}\n\nexport const VerseCard: React.FC<VerseCardProps> = ({\n  ayah,\n  surahName,\n  fontSize,\n  isPlaying,\n  isBookmarked,\n  onPlayAudio,\n  onToggleBookmark,\n}) => {\n  const [copied, setCopied] = useState(false);"
        replacement_content: "import React, { useState } from \'react\';\nimport { Play, Pause, Copy, Check, Bookmark, BookmarkCheck } from \'lucide-react\';\nimport { Ayah, QuranFontChoice } from \'../types/quran.ts\';\nimport { toArabicDigits, copyVerseToClipboard } from \'../utils/quranHelpers.ts\';\n\ninterface VerseCardProps {\n  ayah: Ayah;\n  surahName: string;\n  fontSize: number;\n  fontChoice?: QuranFontChoice;\n  isPlaying: boolean;\n  isBookmarked: boolean;\n  onPlayAudio: (ayah: Ayah) => void;\n  onToggleBookmark: (ayah: Ayah) => void;\n}\n\nexport const VerseCard: React.FC<VerseCardProps> = ({\n  ayah,\n  surahName,\n  fontSize,\n  fontChoice = \'uthman-taha\',\n  isPlaying,\n  isBookmarked,\n  onPlayAudio,\n  onToggleBookmark,\n}) => {\n  const [copied, setCopied] = useState(false);"
