      create_file {
        instruction: "import React from \'react\';\nimport { Play, Pause, SkipBack, SkipForward, X, Volume2, RotateCcw } from \'lucide-react\';\nimport { Ayah, SurahMeta } from \'../types/quran.ts\';\nimport { toArabicDigits } from \'../utils/quranHelpers.ts\';\n\ninterface AudioPlayerBarProps {\n  currentAyah: Ayah | null;\n  currentSurah: SurahMeta | null;\n  isPlaying: boolean;\n  repeatMode: boolean;\n  onTogglePlay: () => void;\n  onNextAyah: () => void;\n  onPrevAyah: () => void;\n  onToggleRepeat: () => void;\n  onClose: () => void;\n}\n\nexport const AudioPlayerBar: React.FC<AudioPlayerBarProps> = ({\n  currentAyah,\n  currentSurah,\n  isPlaying,\n  repeatMode,\n  onTogglePlay,\n  onNextAyah,\n  onPrevAyah,\n  onToggleRepeat,\n  onClose,\n}) => {\n  if (!currentAyah || !currentSurah) return null;\n\n  return (\n    <div className=\"fixed bottom-0 inset-x-0 z-40 bg-white/95 backdrop-blur-md border-t border-stone-200/90 shadow-lg px-4 py-3 sm:px-6\">\n      <div className=\"max-w-6xl mx-auto flex items-center justify-between gap-4\">\n        {/* Ayah & Surah details */}\n        <div className=\"flex items-center gap-3 min-w-0\">\n          <div className=\"w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-700 flex items-center justify-center shrink-0\">\n            <Volume2 className=\"w-5 h-5 animate-pulse\" />\n          </div>\n          <div className=\"min-w-0 text-right\">\n            <div className=\"text-sm font-bold font-quran text-stone-900 truncate\">\n              \330\263\331\210\330\261\330\251 {currentSurah.name} \302\267 \330\247\331\204\330\242\331\212\330\251 {toArabicDigits(currentAyah.aya)}\n            </div>\n            <div className=\"text-xs text-stone-500 font-sans truncate\">\n              \330\247\331\204\331\202\330\247\330\261\330\246 \331\205\330\264\330\247\330\261\331\212 \330\261\330\247\330\264\330\257 \330\247\331\204\330\271\331\201\330\247\330\263\331\212 \302\267 \330\261\331\210\330\247\331\212\330\251 \330\255\331\201\330\265 \330\271\331\206 \330\271\330\247\330\265\331\205\n            </div>\n          </div>\n        </div>\n\n        {/* Audio controls */}\n        <div className=\"flex items-center gap-2 sm:gap-3 shrink-0\">\n          {/* Repeat */}\n          <button\n            onClick={onToggleRepeat}\n            title={repeatMode ? \'\330\252\331\203\330\261\330\247\330\261 \330\247\331\204\330\242\331\212\330\251 \331\205\331\201\330\271\331\204\' : \'\330\252\331\203\330\261\330\247\330\261 \330\247\331\204\330\242\331\212\330\251 \331\205\330\271\330\267\331\204\'}\n            className={`p-2 rounded-lg transition-colors ${\n              repeatMode\n                ? \'bg-amber-100 text-amber-800\'\n                : \'text-stone-500 hover:text-stone-800 hover:bg-stone-100\'\n            }`}\n          >\n            <RotateCcw className=\"w-4 h-4\" />\n          </button>\n\n          {/* Previous Ayah */}\n          <button\n            onClick={onPrevAyah}\n            title=\"\330\247\331\204\330\242\331\212\330\251 \330\247\331\204\330\263\330\247\330\250\331\202\330\251\"\n            className=\"p-2 rounded-lg text-stone-600 hover:text-stone-900 hover:bg-stone-100 transition-colors\"\n          >\n            <SkipForward className=\"w-4 h-4\" />\n          </button>\n\n          {/* Play/Pause */}\n          <button\n            onClick={onTogglePlay}\n            className=\"w-10 h-10 rounded-full bg-stone-900 hover:bg-stone-800 text-white flex items-center justify-center shadow-xs transition-transform active:scale-95\"\n            title={isPlaying ? \'\330\245\331\212\331\202\330\247\331\201 \331\205\330\244\331\202\330\252\' : \'\330\252\330\264\330\272\331\212\331\204\'}\n          >\n            {isPlaying ? (\n              <Pause className=\"w-5 h-5\" />\n            ) : (\n              <Play className=\"w-5 h-5 mr-0.5\" />\n            )}\n          </button>\n\n          {/* Next Ayah */}\n          <button\n            onClick={onNextAyah}\n            title=\"\330\247\331\204\330\242\331\212\330\251 \330\247\331\204\330\252\330\247\331\204\331\212\330\251\"\n            className=\"p-2 rounded-lg text-stone-600 hover:text-stone-900 hover:bg-stone-100 transition-colors\"\n          >\n            <SkipBack className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        {/* Close Button */}\n        <div className=\"flex items-center shrink-0\">\n          <button\n            onClick={onClose}\n            className=\"p-1.5 rounded-lg text-stone-400 hover:text-stone-700 hover:bg-stone-100 transition-colors\"\n            title=\"\330\245\330\272\331\204\330\247\331\202 \330\247\331\204\331\205\330\264\330\272\331\204\"\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
