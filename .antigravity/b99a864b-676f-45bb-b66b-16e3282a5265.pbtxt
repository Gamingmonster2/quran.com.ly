      create_file {
        instruction: "import React from \'react\';\nimport { Play, Pause, ChevronRight, ChevronLeft, Type, AlignLeft, ListOrdered } from \'lucide-react\';\nimport { SurahWithVerses, Ayah, ReadingDisplayMode } from \'../types/quran.ts\';\nimport { toArabicDigits } from \'../utils/quranHelpers.ts\';\nimport { VerseCard } from \'./VerseCard.tsx\';\nimport { MushafContinuous } from \'./MushafContinuous.tsx\';\n\ninterface ReaderViewProps {\n  surah: SurahWithVerses;\n  fontSize: number;\n  setFontSize: React.Dispatch<React.SetStateAction<number>>;\n  displayMode: ReadingDisplayMode;\n  setDisplayMode: (mode: ReadingDisplayMode) => void;\n  playingAyah: Ayah | null;\n  isPlaying: boolean;\n  bookmarkedAyahs: Set<string>;\n  onPlayAyah: (ayah: Ayah) => void;\n  onPlayEntireSurah: () => void;\n  onToggleBookmark: (ayah: Ayah) => void;\n  onPrevSurah?: () => void;\n  onNextSurah?: () => void;\n}\n\nexport const ReaderView: React.FC<ReaderViewProps> = ({\n  surah,\n  fontSize,\n  setFontSize,\n  displayMode,\n  setDisplayMode,\n  playingAyah,\n  isPlaying,\n  bookmarkedAyahs,\n  onPlayAyah,\n  onPlayEntireSurah,\n  onToggleBookmark,\n  onPrevSurah,\n  onNextSurah,\n}) => {\n  const isPlayingThisSurah = isPlaying && playingAyah?.sura === surah.id;\n  const showBismillah = surah.id !== 9 && surah.id !== 1; // Surah 1 includes Bismillah as verse 1; Surah 9 doesn\'t have Bismillah\n\n  return (\n    <div className=\"flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 max-w-5xl mx-auto w-full\">\n      {/* Surah Header Banner */}\n      <div className=\"bg-white border border-stone-200/90 rounded-2xl p-6 sm:p-8 text-center shadow-xs mb-6 relative overflow-hidden\">\n        {/* Subtle decorative background motif */}\n        <div className=\"absolute inset-0 bg-gradient-to-b from-stone-50/80 to-transparent pointer-events-none\" />\n\n        <div className=\"relative z-10 space-y-3\">\n          <div className=\"text-xs uppercase tracking-widest text-stone-500 font-sans\">\n            \330\247\331\204\330\263\331\210\330\261\330\251 \330\261\331\202\331\205 {toArabicDigits(surah.id)} \302\267 {surah.transliteration}\n          </div>\n\n          <h1 className=\"text-3xl sm:text-4xl font-bold font-quran text-stone-900\">\n            \330\263\331\210\330\261\330\251 {surah.name}\n          </h1>\n\n          <div className=\"flex items-center justify-center gap-3 text-xs text-stone-600 font-sans\">\n            <span>{surah.type === \'meccan\' ? \'\331\205\331\203\331\212\330\251\' : \'\331\205\330\257\331\206\331\212\330\251\'}</span>\n            <span aria-hidden=\"true\">\302\267</span>\n            <span>{toArabicDigits(surah.total_verses)} \330\242\331\212\330\251</span>\n            <span aria-hidden=\"true\">\302\267</span>\n            <span>\330\247\331\204\330\261\330\263\331\205 \330\247\331\204\330\271\330\253\331\205\330\247\331\206\331\212 \330\250\330\261\331\210\330\247\331\212\330\251 \330\255\331\201\330\265 \330\271\331\206 \330\271\330\247\330\265\331\205</span>\n          </div>\n\n          {/* Action buttons */}\n          <div className=\"pt-2 flex flex-wrap items-center justify-center gap-3\">\n            <button\n              onClick={onPlayEntireSurah}\n              className=\"inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold text-white bg-stone-900 rounded-lg hover:bg-stone-800 transition-colors shadow-xs\"\n            >\n              {isPlayingThisSurah ? (\n                <>\n                  <Pause className=\"w-4 h-4\" />\n                  <span>\330\245\331\212\331\202\330\247\331\201 \330\247\331\204\330\252\331\204\330\247\331\210\330\251</span>\n                </>\n              ) : (\n                <>\n                  <Play className=\"w-4 h-4\" />\n                  <span>\330\247\330\263\330\252\331\205\330\247\330\271 \331\204\331\204\330\263\331\210\330\261\330\251 \331\203\330\247\331\205\331\204\330\251</span>\n                </>\n              )}\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Reader Controls Toolbar */}\n      <div className=\"bg-[#FAF7F0] border border-stone-200/80 rounded-xl p-3 mb-6 flex flex-wrap items-center justify-between gap-4 text-xs font-sans\">\n        {/* Display Mode Switcher */}\n        <div className=\"flex items-center gap-1 p-1 bg-stone-200/60 rounded-lg\">\n          <button\n            onClick={() => setDisplayMode(\'verses\')}\n            className={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md font-medium transition-colors ${\n              displayMode === \'verses\'\n                ? \'bg-white text-stone-900 shadow-xs\'\n                : \'text-stone-600 hover:text-stone-900\'\n            }`}\n          >\n            <ListOrdered className=\"w-3.5 h-3.5\" />\n            <span>\330\242\331\212\330\251 \330\250\330\242\331\212\330\251</span>\n          </button>\n          <button\n            onClick={() => setDisplayMode(\'continuous\')}\n            className={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md font-medium transition-colors ${\n              displayMode === \'continuous\'\n                ? \'bg-white text-stone-900 shadow-xs\'\n                : \'text-stone-600 hover:text-stone-900\'\n            }`}\n          >\n            <AlignLeft className=\"w-3.5 h-3.5\" />\n            <span>\331\202\330\261\330\247\330\241\330\251 \331\205\330\252\330\265\331\204\330\251</span>\n          </button>\n        </div>\n\n        {/* Font Size Adjuster */}\n        <div className=\"flex items-center gap-2 text-stone-700\">\n          <Type className=\"w-4 h-4 text-stone-400\" />\n          <span className=\"text-xs\">\330\255\330\254\331\205 \330\247\331\204\330\256\330\267:</span>\n          <div className=\"flex items-center gap-1 bg-white border border-stone-300 rounded-lg p-0.5\">\n            <button\n              onClick={() => setFontSize((s) => Math.max(18, s - 2))}\n              className=\"px-2 py-0.5 hover:bg-stone-100 rounded text-stone-700 font-bold transition-colors\"\n              title=\"\330\252\330\265\330\272\331\212\330\261 \330\247\331\204\330\256\330\267\"\n            >\n              -\n            </button>\n            <span className=\"px-2 text-xs font-mono font-medium text-stone-800\">\n              {fontSize}px\n            </span>\n            <button\n              onClick={() => setFontSize((s) => Math.min(42, s + 2))}\n              className=\"px-2 py-0.5 hover:bg-stone-100 rounded text-stone-700 font-bold transition-colors\"\n              title=\"\330\252\331\203\330\250\331\212\330\261 \330\247\331\204\330\256\330\267\"\n            >\n              +\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Bismillah Header (if applicable) */}\n      {showBismillah && (\n        <div className=\"my-6 text-center font-quran text-2xl sm:text-3xl text-stone-800 select-none py-2 border-b border-stone-200/60 pb-5\">\n          \330\250\331\220\330\263\333\241\331\205\331\220 \331\261\331\204\331\204\331\221\331\216\331\207\331\220 \331\261\331\204\330\261\331\221\331\216\330\255\333\241\331\205\331\216\331\260\331\206\331\220 \331\261\331\204\330\261\331\221\331\216\330\255\331\220\331\212\331\205\331\220\n        </div>\n      )}\n\n      {/* Verses Content */}\n      {displayMode === \'continuous\' ? (\n        <MushafContinuous\n          verses={surah.verses}\n          fontSize={fontSize}\n          playingAyahNumber={\n            isPlaying && playingAyah?.sura === surah.id ? playingAyah.aya : null\n          }\n          onSelectAyah={onPlayAyah}\n        />\n      ) : (\n        <div className=\"space-y-4\">\n          {surah.verses.map((ayah) => {\n            const isPlayingThisAyah =\n              isPlaying &&\n              playingAyah?.sura === ayah.sura &&\n              playingAyah?.aya === ayah.aya;\n            const isBookmarked = bookmarkedAyahs.has(`${ayah.sura}:${ayah.aya}`);\n\n            return (\n              <VerseCard\n                key={ayah.aya}\n                ayah={ayah}\n                surahName={surah.name}\n                fontSize={fontSize}\n                isPlaying={isPlayingThisAyah}\n                isBookmarked={isBookmarked}\n                onPlayAudio={onPlayAyah}\n                onToggleBookmark={onToggleBookmark}\n              />\n            );\n          })}\n        </div>\n      )}\n\n      {/* Prev / Next Surah Navigation */}\n      <div className=\"mt-10 pt-6 border-t border-stone-200 flex items-center justify-between text-sm font-sans\">\n        {onPrevSurah ? (\n          <button\n            onClick={onPrevSurah}\n            className=\"inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-white border border-stone-200 text-stone-700 hover:text-stone-900 hover:border-stone-300 transition-colors shadow-2xs\"\n          >\n            <ChevronRight className=\"w-4 h-4\" />\n            <span>\330\247\331\204\330\263\331\210\330\261\330\251 \330\247\331\204\330\263\330\247\330\250\331\202\330\251</span>\n          </button>\n        ) : (\n          <div />\n        )}\n\n        {onNextSurah && (\n          <button\n            onClick={onNextSurah}\n            className=\"inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-white border border-stone-200 text-stone-700 hover:text-stone-900 hover:border-stone-300 transition-colors shadow-2xs\"\n          >\n            <span>\330\247\331\204\330\263\331\210\330\261\330\251 \330\247\331\204\330\252\330\247\331\204\331\212\330\251</span>\n            <ChevronLeft className=\"w-4 h-4\" />\n          </button>\n        )}\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/ReaderView.tsx"
        }
        overwrite: true
      }
    }
