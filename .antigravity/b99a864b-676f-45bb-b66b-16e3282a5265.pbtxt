    proposed_command_line: "node -e \'\nasync function inspect() {\n  const res = await fetch(\"https://api.alquran.cloud/v1/quran/quran-uthmani\");\n  const data = await res.json();\n  console.log(\"data.code:\", data.code);\n  console.log(\"surahs count:\", data.data?.surahs?.length);\n  if (data.data?.surahs?.length > 0) {\n    const s1 = data.data.surahs[0];\n    console.log(\"Sura 1:\", s1.number, s1.name, s1.englishName, \"ayahs:\", s1.ayahs.length);\n    console.log(\"First ayah:\", s1.ayahs[0]);\n  }\n}\ninspect();\n\'"
