          replacement_content: "      {/* Reader Controls Toolbar */}\n      <div className=\"bg-[#FAF7F0] border border-stone-200/80 rounded-xl p-3 mb-6 flex flex-wrap items-center justify-between gap-3 text-xs font-sans\">\n        {/* Display Mode Switcher */}\n        <div className=\"flex items-center gap-1 p-1 bg-stone-200/60 rounded-lg\">\n          <button\n            onClick={() => setDisplayMode(\'verses\')}\n            className={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md font-medium transition-colors ${\n              displayMode === \'verses\'\n                ? \'bg-white text-stone-900 shadow-xs\'\n                : \'text-stone-600 hover:text-stone-900\'\n            }`}\n          >\n            <ListOrdered className=\"w-3.5 h-3.5\" />\n            <span>\330\242\331\212\330\251 \330\250\330\242\331\212\330\251</span>\n          </button>\n          <button\n            onClick={() => setDisplayMode(\'continuous\')}\n            className={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md font-medium transition-colors ${\n              displayMode === \'continuous\'\n                ? \'bg-white text-stone-900 shadow-xs\'\n                : \'text-stone-600 hover:text-stone-900\'\n            }`}\n          >\n            <AlignLeft className=\"w-3.5 h-3.5\" />\n            <span>\331\202\330\261\330\247\330\241\330\251 \331\205\330\252\330\265\331\204\330\251</span>\n          </button>\n        </div>\n\n        {/* Font Selector & Size Adjuster */}\n        <div className=\"flex flex-wrap items-center gap-3\">\n          {/* Font Selector */}\n          <div className=\"flex items-center gap-1.5 text-stone-700\">\n            <span>\330\247\331\204\330\256\330\267:</span>\n            <select\n              value={fontChoice}\n              onChange={(e) => setFontChoice(e.target.value as QuranFontChoice)}\n              className=\"bg-white border border-stone-300 rounded-lg px-2.5 py-1 text-xs text-stone-800 focus:outline-none focus:ring-1 focus:ring-stone-800\"\n            >\n              <option value=\"uthman-taha\">\330\271\330\253\331\205\330\247\331\206 \330\267\331\207 (\331\205\330\254\331\205\330\271 \330\247\331\204\331\205\331\204\331\203 \331\201\331\207\330\257 - \331\205\330\255\331\204\331\212 TTF)</option>\n              <option value=\"hafs-v18\">\330\255\331\201\330\265 \330\247\331\204\330\245\330\265\330\257\330\247\330\261 \331\241\331\250 (KFGQPC TTF)</option>\n              <option value=\"amiri\">\330\247\331\204\330\243\331\205\331\212\330\261\331\212 \330\247\331\204\331\202\330\261\330\242\331\206\331\212 (Amiri Quran)</option>\n            </select>\n          </div>\n\n          {/* Font Size Adjuster */}\n          <div className=\"flex items-center gap-2 text-stone-700\">\n            <Type className=\"w-4 h-4 text-stone-400\" />\n            <span className=\"text-xs\">\330\247\331\204\330\255\330\254\331\205:</span>\n            <div className=\"flex items-center gap-1 bg-white border border-stone-300 rounded-lg p-0.5\">\n              <button\n                onClick={() => setFontSize((s) => Math.max(18, s - 2))}\n                className=\"px-2 py-0.5 hover:bg-stone-100 rounded text-stone-700 font-bold transition-colors\"\n                title=\"\330\252\330\265\330\272\331\212\330\261 \330\247\331\204\330\256\330\267\"\n              >\n                -\n              </button>\n              <span className=\"px-2 text-xs font-mono font-medium text-stone-800\">\n                {fontSize}px\n              </span>\n              <button\n                onClick={() => setFontSize((s) => Math.min(42, s + 2))}\n                className=\"px-2 py-0.5 hover:bg-stone-100 rounded text-stone-700 font-bold transition-colors\"\n                title=\"\330\252\331\203\330\250\331\212\330\261 \330\247\331\204\330\256\330\267\"\n              >\n                +\n              </button>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Bismillah Header (if applicable) */}\n      {showBismillah && (\n        <div\n          className={`my-6 text-center text-2xl sm:text-3xl text-stone-800 select-none py-2 border-b border-stone-200/60 pb-5 ${\n            fontChoice === \'uthman-taha\'\n              ? \'font-uthman-taha\'\n              : fontChoice === \'hafs-v18\'\n              ? \'font-hafs-v18\'\n              : \'font-amiri-quran\'\n          }`}\n        >\n          \330\250\331\220\330\263\333\241\331\205\331\220 \331\261\331\204\331\204\331\221\331\216\331\207\331\220 \331\261\331\204\330\261\331\221\331\216\330\255\333\241\331\205\331\216\331\260\331\206\331\220 \331\261\331\204\330\261\331\221\331\216\330\255\331\220\331\212\331\205\331\220\n        </div>\n      )}\n\n      {/* Verses Content */}\n      {displayMode === \'continuous\' ? (\n        <MushafContinuous\n          verses={surah.verses}\n          fontSize={fontSize}\n          fontChoice={fontChoice}\n          playingAyahNumber={\n            isPlaying && playingAyah?.sura === surah.id ? playingAyah.aya : null\n          }\n          onSelectAyah={onPlayAyah}\n        />\n      ) : (\n        <div className=\"space-y-4\">\n          {surah.verses.map((ayah) => {\n            const isPlayingThisAyah =\n              isPlaying &&\n              playingAyah?.sura === ayah.sura &&\n              playingAyah?.aya === ayah.aya;\n            const isBookmarked = bookmarkedAyahs.has(`${ayah.sura}:${ayah.aya}`);\n\n            return (\n              <VerseCard\n                key={ayah.aya}\n                ayah={ayah}\n                surahName={surah.name}\n                fontSize={fontSize}\n                fontChoice={fontChoice}\n                isPlaying={isPlayingThisAyah}\n                isBookmarked={isBookmarked}\n                onPlayAudio={onPlayAyah}\n                onToggleBookmark={onToggleBookmark}\n              />\n            );\n          })}\n        </div>\n      )}"
          start_line: 90
          end_line: 180
        }
      }
