    content: "        </div>\n      </div>\n\n      {/* Reader Controls Toolbar */}\n      <div className=\"bg-[#FAF7F0] border border-stone-200/80 rounded-xl p-3 mb-6 flex flex-wrap items-center justify-between gap-4 text-xs font-sans\">\n        {/* Display Mode Switcher */}\n        <div className=\"flex items-center gap-1 p-1 bg-stone-200/60 rounded-lg\">\n          <button\n            onClick={() => setDisplayMode(\'verses\')}\n            className={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md font-medium transition-colors ${\n              displayMode === \'verses\'\n                ? \'bg-white text-stone-900 shadow-xs\'\n                : \'text-stone-600 hover:text-stone-900\'\n            }`}\n          >\n            <ListOrdered className=\"w-3.5 h-3.5\" />\n            <span>\330\242\331\212\330\251 \330\250\330\242\331\212\330\251</span>\n          </button>\n          <button\n            onClick={() => setDisplayMode(\'continuous\')}\n            className={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md font-medium transition-colors ${\n              displayMode === \'continuous\'\n                ? \'bg-white text-stone-900 shadow-xs\'\n                : \'text-stone-600 hover:text-stone-900\'\n            }`}\n          >\n            <AlignLeft className=\"w-3.5 h-3.5\" />\n            <span>\331\202\330\261\330\247\330\241\330\251 \331\205\330\252\330\265\331\204\330\251</span>\n          </button>\n        </div>\n\n        {/* Font Size Adjuster */}\n        <div className=\"flex items-center gap-2 text-stone-700\">\n          <Type className=\"w-4 h-4 text-stone-400\" />\n          <span className=\"text-xs\">\330\255\330\254\331\205 \330\247\331\204\330\256\330\267:</span>\n          <div className=\"flex items-center gap-1 bg-white border border-stone-300 rounded-lg p-0.5\">\n            <button\n              onClick={() => setFontSize((s) => Math.max(18, s - 2))}\n              className=\"px-2 py-0.5 hover:bg-stone-100 rounded text-stone-700 font-bold transition-colors\"\n              title=\"\330\252\330\265\330\272\331\212\330\261 \330\247\331\204\330\256\330\267\"\n            >\n              -\n            </button>\n            <span className=\"px-2 text-xs font-mono font-medium text-stone-800\">\n              {fontSize}px\n            </span>\n            <button\n              onClick={() => setFontSize((s) => Math.min(42, s + 2))}\n              className=\"px-2 py-0.5 hover:bg-stone-100 rounded text-stone-700 font-bold transition-colors\"\n              title=\"\330\252\331\203\330\250\331\212\330\261 \330\247\331\204\330\256\330\267\"\n            >\n              +\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Bismillah Header (if applicable) */}\n      {showBismillah && (\n        <div className=\"my-6 text-center font-quran text-2xl sm:text-3xl text-stone-800 select-none py-2 border-b border-stone-200/60 pb-5\">\n          \330\250\331\220\330\263\333\241\331\205\331\220 \331\261\331\204\331\204\331\221\331\216\331\207\331\220 \331\261\331\204\330\261\331\221\331\216\330\255\333\241\331\205\331\216\331\260\331\206\331\220 \331\261\331\204\330\261\331\221\331\216\330\255\331\220\331\212\331\205\331\220\n        </div>\n      )}\n\n      {/* Verses Content */}\n      {displayMode === \'continuous\' ? (\n        <MushafContinuous\n          verses={surah.verses}\n          fontSize={fontSize}\n          playingAyahNumber={\n            isPlaying && playingAyah?.sura === surah.id ? playingAyah.aya : null\n          }\n          onSelectAyah={onPlayAyah}\n        />\n      ) : (\n        <div className=\"space-y-4\">"
    num_lines: 211
