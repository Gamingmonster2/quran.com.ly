  planner_response {
    thinking: "**Building Data Inspector Modal**\n\nI\'m now focused on constructing the `DataInspectorModal.tsx` component to directly address the user\'s request. My current aim is to display the `assets/data/quran.json` data and validate its structure. I need to verify that each entry contains the expected `sura` key with its corresponding numeric range (1-114).\n\n\n"
    tool_calls {
      id: "call_86407"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { Download, FileJson, Copy, Check, ExternalLink, Code2, Database } from \'lucide-react\';\\nimport { Ayah, SurahMeta } from \'../types/quran.ts\';\\n\\ninterface DataInspectorProps {\\n  allVerses: Ayah[];\\n  surahs: SurahMeta[];\\n  onClose?: () => void;\\n  isModal?: boolean;\\n}\\n\\nexport const DataInspectorModal: React.FC<DataInspectorProps> = ({\\n  allVerses,\\n  surahs,\\n  onClose,\\n  isModal = false,\\n}) => {\\n  const [activeTab, setActiveTab] = useState<\'preview\' | \'schema\' | \'code\'>(\'preview\');\\n  const [copiedCode, setCopiedCode] = useState(false);\\n  const [codeLang, setCodeLang] = useState<\'javascript\' | \'python\' | \'curl\'>(\'javascript\');\\n\\n  const sampleVerses = allVerses.slice(0, 7);\\n\\n  const downloadFile = (url: string, filename: string) => {\\n    const link = document.createElement(\'a\');\\n    link.href = url;\\n    link.download = filename;\\n    document.body.appendChild(link);\\n    link.click();\\n    document.body.removeChild(link);\\n  };\\n\\n  const codeSnippets: Record<string, string> = {\\n    javascript: `// \330\247\330\263\330\252\331\212\330\261\330\247\330\257 \331\210\331\202\330\261\330\247\330\241\330\251 \331\205\331\204\331\201 \330\247\331\204\331\202\330\261\330\242\331\206 \330\247\331\204\331\203\330\261\331\212\331\205 \331\201\331\212 Node.js / TypeScript\\nimport fs from \'node:fs\';\\n\\ninterface Ayah {\\n  sura: number; // 1 - 114\\n  aya: number;  // 1 - n\\n  text: string; // \330\247\331\204\330\261\330\263\331\205 \330\247\331\204\330\271\330\253\331\205\330\247\331\206\331\212\\n}\\n\\nconst quranData: Ayah[] = JSON.parse(\\n  fs.readFileSync(\'./assets/data/quran.json\', \'utf-8\')\\n);\\n\\nconsole.log(\\\\`\330\245\330\254\331\205\330\247\331\204\331\212 \330\247\331\204\330\242\331\212\330\247\330\252: \\\\${quranData.length}\\\\`); // 6236\\nconst firstAyah = quranData[0];\\nconsole.log(firstAyah.text); // \330\250\331\220\330\263\333\241\331\205\331\220 \331\261\331\204\331\204\331\221\331\216\331\207\331\220 \331\261\331\204\330\261\331\221\331\216\330\255\333\241\331\205\331\216\331\260\331\206\331\220 \331\261\331\204\330\261\331\221\331\216\330\255\331\220\331\212\331\205\331\220`,\\n\\n    python: `# \331\202\330\261\330\247\330\241\330\251 \331\205\331\204\331\201 \330\247\331\204\331\202\330\261\330\242\331\206 \330\247\331\204\331\203\330\261\331\212\331\205 \331\201\331\212 Python\\nimport json\\n\\nwith open(\'./assets/data/quran.json\', \'r\', encoding=\'utf-8\') as f:\\n    quran = json.load(f)\\n\\nprint(f\\\"\330\245\330\254\331\205\330\247\331\204\331\212 \330\247\331\204\330\242\331\212\330\247\330\252: {len(quran)}\\\") # 6236\\n# \330\252\330\265\331\201\331\212\330\251 \330\242\331\212\330\247\330\252 \330\263\331\210\330\261\330\251 \330\247\331\204\330\245\330\256\331\204\330\247\330\265 (\330\261\331\202\331\205 112)\\nikhlas_ayahs = [v for v in quran if v[\'sura\'] == 112]\\nfor ayah in ikhlas_ayahs:\\n    print(f\\\"{ayah[\'aya\']}: {ayah[\'text\']}\\\")`,\\n\\n    curl: `# \330\252\331\206\330\262\331\212\331\204 \331\205\331\204\331\201 \330\247\331\204\331\202\330\261\330\242\331\206 \330\247\331\204\331\203\330\261\331\212\331\205 \330\247\331\204\330\264\330\247\331\205\331\204 \331\205\330\250\330\247\330\264\330\261\330\251\\ncurl -O https://cdn.jsdelivr.net/npm/quran-json@3.1.2/dist/quran.json\\n\\n# \330\243\331\210 \330\247\331\204\331\210\330\265\331\210\331\204 \331\204\331\204\331\205\331\204\331\201 \330\247\331\204\331\205\330\255\331\204\331\212 \331\205\331\206 \331\205\330\263\330\247\330\261 \330\247\331\204\330\252\330\267\330\250\331\212\331\202:\\n# assets/data/quran.json`\\n  };\\n\\n  const handleCopyCode = async () => {\\n    await navigator.clipboard.writeText(codeSnippets[codeLang]);\\n    setCopiedCode(true);\\n    setTimeout(() => setCopiedCode(false), 2000);\\n  };\\n\\n  const content = (\\n    <div className=\\\"space-y-6 text-right\\\">\\n      {/* Title & Stats */}\\n      <div className=\\\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-4 border-b border-stone-200\\\">\\n        <div className=\\\"flex items-center gap-3\\\">\\n          <div className=\\\"w-12 h-12 rounded-xl bg-stone-900 text-white flex items-center justify-center shrink-0\\\">\\n            <Database className=\\\"w-6 h-6\\\" />\\n          </div>\\n          <div>\\n            <h2 className=\\\"text-xl sm:text-2xl font-bold font-quran text-stone-900\\\">\\n              \331\205\330\263\330\252\331\210\330\257\330\271 \330\250\331\212\330\247\331\206\330\247\330\252 \330\247\331\204\331\202\330\261\330\242\331\206 \330\247\331\204\331\203\330\261\331\212\331\205 (quran.json)\\n            </h2>\\n            <p className=\\\"text-xs text-stone-500 font-sans mt-0.5\\\">\\n              \330\250\331\212\330\247\331\206\330\247\330\252 \331\205\331\201\330\252\331\210\330\255\330\251 \330\247\331\204\331\205\330\265\330\257\330\261 \330\250\330\247\331\204\330\261\330\263\331\205 \330\247\331\204\330\271\330\253\331\205\330\247\331\206\331\212 \330\247\331\204\330\252\330\247\331\205 (Hafs Uthmani Script)\\n            </p>\\n          </div>\\n        </div>\\n\\n        {/* Download Buttons Strip */}\\n        <div className=\\\"flex flex-wrap items-center gap-2\\\">\\n          <button\\n            onClick={() => downloadFile(\'/assets/data/quran.json\', \'quran.json\')}\\n            className=\\\"inline-flex items-center gap-2 px-3.5 py-2 text-xs font-semibold text-white bg-stone-900 hover:bg-stone-800 rounded-lg transition-colors shadow-xs\\\"\\n          >\\n            <Download className=\\\"w-3.5 h-3.5\\\" />\\n            <span>\330\252\331\206\330\262\331\212\331\204 quran.json (\331\241.\331\246 \331\205\331\212\330\272\330\247\330\250\330\247\331\212\330\252)</span>\\n          </button>\\n          <button\\n            onClick={() =>\\n              downloadFile(\'/assets/data/quran-by-surah.json\', \'quran-by-surah.json\')\\n            }\\n            className=\\\"inline-flex items-center gap-2 px-3 py-2 text-xs font-medium text-stone-700 bg-white border border-stone-200 hover:bg-stone-50 rounded-lg transition-colors shadow-2xs\\\"\\n          >\\n            <FileJson className=\\\"w-3.5 h-3.5 text-stone-500\\\" />\\n            <span>\331\205\331\202\330\263\331\205 \330\255\330\263\330\250 \330\247\331\204\330\263\331\210\330\261</span>\\n          </button>\\n        </div>\\n      </div>\\n\\n      {/* Dataset Specs Summary */}\\n      <div className=\\\"grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs font-sans\\\">\\n        <div className=\\\"p-3 rounded-xl bg-stone-50 border border-stone-200/80\\\">\\n          <div className=\\\"text-stone-400\\\">\330\271\330\257\330\257 \330\247\331\204\330\263\331\210\330\261 \330\247\331\204\331\203\331\204\331\212</div>\\n          <div className=\\\"text-lg font-bold font-mono text-stone-900 mt-1\\\">\\n            {surahs.length || 114}\\n          </div>\\n        </div>\\n        <div className=\\\"p-3 rounded-xl bg-stone-50 border border-stone-200/80\\\">\\n          <div className=\\\"text-stone-400\\\">\330\245\330\254\331\205\330\247\331\204\331\212 \330\247\331\204\330\242\331\212\330\247\330\252</div>\\n          <div className=\\\"text-lg font-bold font-mono text-stone-900 mt-1\\\">\\n            {allVerses.length || 6236}\\n          </div>\\n        </div>\\n        <div className=\\\"p-3 rounded-xl bg-stone-50 border border-stone-200/80\\\">\\n          <div className=\\\"text-stone-400\\\">\330\247\331\204\330\261\330\263\331\205 \331\210\330\247\331\204\330\256\330\267</div>\\n          <div className=\\\"text-lg font-bold text-stone-900 mt-1\\\">\\n            \330\271\330\253\331\205\330\247\331\206\331\212 \331\205\330\264\331\203\331\210\331\204\\n          </div>\\n        </div>\\n        <div className=\\\"p-3 rounded-xl bg-stone-50 border border-stone-200/80\\\">\\n          <div className=\\\"text-stone-400\\\">\331\205\330\263\330\247\330\261 \330\247\331\204\331\205\331\204\331\201 \331\201\331\212 \330\247\331\204\331\205\330\264\330\261\331\210\330\271</div>\\n          <div className=\\\"text-xs font-mono text-emerald-800 font-semibold mt-1.5 truncate\\\" dir=\\\"ltr\\\">\\n            assets/data/quran.json\\n          </div>\\n        </div>\\n      </div>\\n\\n      {/* Tabs */}\\n      <div className=\\\"flex items-center justify-between border-b border-stone-200 text-xs font-sans\\\">\\n        <div className=\\\"flex items-center gap-2\\\">\\n          <button\\n            onClick={() => setActiveTab(\'preview\')}\\n            className={`pb-2.5 font-medium transition-colors border-b-2 ${\\n              activeTab === \'preview\'\\n                ? \'border-stone-900 text-stone-950 font-bold\'\\n                : \'border-transparent text-stone-500 hover:text-stone-900\'\\n            }`}\\n          >\\n            \331\205\330\271\330\247\331\212\331\206\330\251 \330\247\331\204\330\250\331\212\330\247\331\206\330\247\330\252 (Live Preview)\\n          </button>\\n          <button\\n            onClick={() => setActiveTab(\'schema\')}\\n            className={`pb-2.5 font-medium transition-colors border-b-2 ${\\n              activeTab === \'schema\'\\n                ? \'border-stone-900 text-stone-950 font-bold\'\\n                : \'border-transparent text-stone-500 hover:text-stone-900\'\\n            }`}\\n          >\\n            \331\207\331\212\331\203\331\204\331\212\330\251 \330\247\331\204\331\200 JSON (Schema)\\n          </button>\\n          <button\\n            onClick={() => setActiveTab(\'code\')}\\n            className={`pb-2.5 font-medium transition-colors border-b-2 ${\\n              activeTab === \'code\'\\n                ? \'border-stone-900 text-stone-950 font-bold\'\\n                : \'border-transparent text-stone-500 hover:text-stone-900\'\\n            }`}\\n          >\\n            \330\243\331\205\330\253\331\204\330\251 \330\250\330\261\331\205\330\254\331\212\330\251 \331\204\331\204\330\247\330\263\330\252\330\256\330\257\330\247\331\205\\n          </button>\\n        </div>\\n\\n        {activeTab === \'code\' && (\\n          <button\\n            onClick={handleCopyCode}\\n            className=\\\"inline-flex items-center gap-1.5 px-2.5 py-1 text-xs rounded bg-stone-100 hover:bg-stone-200 text-stone-700 transition-colors\\\"\\n          >\\n            {copiedCode ? (\\n              <>\\n                <Check className=\\\"w-3.5 h-3.5 text-emerald-600\\\" />\\n                <span>\330\252\331\205 \330\247\331\204\331\206\330\263\330\256!</span>\\n              </>\\n            ) : (\\n              <>\\n                <Copy className=\\\"w-3.5 h-3.5\\\" />\\n                <span>\331\206\330\263\330\256 \330\247\331\204\331\203\331\210\330\257</span>\\n              </>\\n            )}\\n          </button>\\n        )}\\n      </div>\\n\\n      {/* Tab 1: Live Preview */}\\n      {activeTab === \'preview\' && (\\n        <div className=\\\"space-y-2\\\">\\n          <div className=\\\"text-xs text-stone-500 font-sans flex items-center justify-between\\\">\\n            <span>\330\271\331\212\331\206\330\251 \331\205\331\206 \330\243\331\210\331\204 \331\247 \330\242\331\212\330\247\330\252 (\330\263\331\210\330\261\330\251 \330\247\331\204\331\201\330\247\330\252\330\255\330\251 \331\203\330\247\331\205\331\204\330\251 \330\250\330\247\331\204\330\261\330\263\331\205 \330\247\331\204\330\271\330\253\331\205\330\247\331\206\331\212):</span>\\n            <span className=\\\"font-mono text-stone-400\\\">Array of Objects</span>\\n          </div>\\n          <div\\n            className=\\\"bg-stone-950 text-stone-100 p-4 rounded-xl font-mono text-xs overflow-x-auto max-h-72 leading-relaxed\\\"\\n            dir=\\\"ltr\\\"\\n          >\\n            <pre>{JSON.stringify(sampleVerses, null, 2)}</pre>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* Tab 2: Schema */}\\n      {activeTab === \'schema\' && (\\n        <div className=\\\"bg-white border border-stone-200/90 rounded-xl p-5 space-y-4 font-sans text-xs\\\">\\n          <h4 className=\\\"font-bold text-stone-900 text-sm\\\">\\n            \331\205\331\210\330\247\330\265\331\201\330\247\330\252 \331\207\331\212\331\203\331\204 \331\203\331\204 \331\203\330\247\330\246\331\206 \330\242\331\212\330\251 \331\201\331\212 \331\205\331\204\331\201 quran.json:\\n          </h4>\\n          <div className=\\\"divide-y divide-stone-100\\\">\\n            <div className=\\\"py-2.5 flex items-start justify-between gap-4\\\">\\n              <div>\\n                <span className=\\\"font-mono font-bold text-emerald-700\\\">sura</span>\\n                <span className=\\\"text-stone-400 mr-2\\\">(number)</span>\\n                <p className=\\\"text-stone-600 mt-0.5\\\">\\n                  \330\261\331\202\331\205 \330\247\331\204\330\263\331\210\330\261\330\251 \331\201\331\212 \330\247\331\204\331\205\330\265\330\255\331\201 \330\247\331\204\330\264\330\261\331\212\331\201 \331\205\331\206 \331\241 (\330\247\331\204\331\201\330\247\330\252\330\255\330\251) \330\245\331\204\331\211 \331\241\331\241\331\244 (\330\247\331\204\331\206\330\247\330\263).\\n                </p>\\n              </div>\\n              <span className=\\\"font-mono text-stone-400 shrink-0\\\">1 .. 114</span>\\n            </div>\\n\\n            <div className=\\\"py-2.5 flex items-start justify-between gap-4\\\">\\n              <div>\\n                <span className=\\\"font-mono font-bold text-emerald-700\\\">aya</span>\\n                <span className=\\\"text-stone-400 mr-2\\\">(number)</span>\\n                <p className=\\\"text-stone-600 mt-0.5\\\">\\n                  \330\261\331\202\331\205 \330\247\331\204\330\242\331\212\330\251 \330\257\330\247\330\256\331\204 \330\247\331\204\330\263\331\210\330\261\330\251 \330\247\331\204\331\205\330\255\330\257\330\257\330\251 \330\252\330\263\331\204\330\263\331\204\331\212\330\247\331\213 \330\250\330\257\330\241\330\247\331\213 \331\205\331\206 \331\241.\\n                </p>\\n              </div>\\n              <span className=\\\"font-mono text-stone-400 shrink-0\\\">1 .. n</span>\\n            </div>\\n\\n            <div className=\\\"py-2.5 flex items-start justify-between gap-4\\\">\\n              <div>\\n                <span className=\\\"font-mono font-bold text-emerald-700\\\">text</span>\\n                <span className=\\\"text-stone-400 mr-2\\\">(string)</span>\\n                <p className=\\\"text-stone-600 mt-0.5\\\">\\n                  \331\206\330\265 \330\247\331\204\330\242\331\212\330\251 \330\247\331\204\331\203\330\261\331\212\331\205\330\251 \330\250\330\247\331\204\330\261\330\263\331\205 \330\247\331\204\330\271\330\253\331\205\330\247\331\206\331\212 \330\247\331\204\330\252\330\247\331\205 \331\205\330\271 \331\203\330\247\331\205\331\204 \330\271\331\204\330\247\331\205\330\247\330\252 \330\247\331\204\330\252\330\264\331\203\331\212\331\204\330\214 \330\247\331\204\331\205\330\257\331\210\330\257\330\214 \331\210\330\271\331\204\330\247\331\205\330\247\330\252 \330\247\331\204\331\210\331\202\331\201 \330\247\331\204\331\205\330\271\330\252\331\205\330\257\330\251 \330\250\331\205\330\265\330\255\331\201 \330\247\331\204\331\205\330\257\331\212\331\206\330\251 \330\247\331\204\331\205\331\206\331\210\330\261\330\251.\\n                </p>\\n              </div>\\n              <span className=\\\"font-mono text-stone-400 shrink-0\\\">UTF-8 Uthmani</span>\\n            </div>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* Tab 3: Code Snippets */}\\n      {activeTab === \'code\' && (\\n        <div className=\\\"space-y-3 font-sans\\\">\\n          <div className=\\\"flex items-center gap-1.5 text-xs\\\">\\n            <button\\n              onClick={() => setCodeLang(\'javascript\')}\\n              className={`px-3 py-1 rounded-md transition-colors ${\\n                codeLang === \'javascript\'\\n                  ? \'bg-stone-900 text-white font-semibold\'\\n                  : \'bg-stone-100 text-stone-600 hover:text-stone-900\'\\n              }`}\\n            >\\n              JavaScript / Node.js\\n            </button>\\n            <button\\n              onClick={() => setCodeLang(\'python\')}\\n              className={`px-3 py-1 rounded-md transition-colors ${\\n                codeLang === \'python\'\\n                  ? \'bg-stone-900 text-white font-semibold\'\\n                  : \'bg-stone-100 text-stone-600 hover:text-stone-900\'\\n              }`}\\n            >\\n              Python\\n            </button>\\n            <button\\n              onClick={() => setCodeLang(\'curl\')}\\n              className={`px-3 py-1 rounded-md transition-colors ${\\n                codeLang === \'curl\'\\n                  ? \'bg-stone-900 text-white font-semibold\'\\n                  : \'bg-stone-100 text-stone-600 hover:text-stone-900\'\\n              }`}\\n            >\\n              cURL / Shell\\n            </button>\\n          </div>\\n\\n          <div\\n            className=\\\"bg-stone-950 text-stone-100 p-4 rounded-xl font-mono text-xs overflow-x-auto leading-relaxed\\\"\\n            dir=\\\"ltr\\\"\\n          >\\n            <pre>{codeSnippets[codeLang]}</pre>\\n          </div>\\n        </div>\\n      )}\\n    </div>\\n  );\\n\\n  if (isModal) {\\n    return (\\n      <div className=\\\"fixed inset-0 z-50 bg-black/50 backdrop-blur-xs flex items-center justify-center p-4\\\">\\n        <div className=\\\"bg-white border border-stone-200 rounded-2xl p-6 sm:p-8 max-w-3xl w-full max-h-[90vh] overflow-y-auto shadow-2xl relative\\\">\\n          {onClose && (\\n            <button\\n              onClick={onClose}\\n              className=\\\"absolute left-6 top-6 p-2 rounded-lg text-stone-400 hover:text-stone-700 hover:bg-stone-100 transition-colors text-xs font-sans\\\"\\n            >\\n              \330\245\330\272\331\204\330\247\331\202 \342\234\225\\n            </button>\\n          )}\\n          {content}\\n        </div>\\n      </div>\\n    );\\n  }\\n\\n  return (\\n    <div className=\\\"flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 max-w-4xl mx-auto w-full\\\">\\n      <div className=\\\"bg-white border border-stone-200/90 rounded-2xl p-6 sm:p-8 shadow-xs\\\">\\n        {content}\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Data repository inspector and download modal for quran.json with schema and code examples\", \"Overwrite\":true, \"TargetFile\":\"/src/components/DataInspectorModal.tsx\", \"toolAction\":\"Creating DataInspectorModal component\", \"toolSummary\":\"Create DataInspectorModal component\"}"
      thinking_signature: "\022\242\a\n\237\a\001i\024}\023j\346\004o\326\374cdl\264\205\270\000\263\'\352-\"\312t\272p\302N\033\222\204\276\361\273\005\002\037\356\343\357q\271g\3556n\214\204pz\370M\35143\0234\207\202\026 \210\301bfR\b\343 )\311\017;\262\254B\375T\305h@\"\224\325\031\'\200\341R\323\227w\371Wf\025m\025\306TXV\342\371(\027\0227\003\360\263\372z\032;\026B\250\207\376\r\300\323%\v\352:\305\177\tPA2\213>\350\222\332V\226\334O\364*\3356\b\246\363\236\210 ur\323\006^p\004\235\272y\022\252\230\320\240y\361\305\252\204\202\376\273\211\0315\031;(\367\325\251\271\024 \337\022\373\343\377\032e\r;\253k\v\364N\235\224t\255\256\371.\225^T\342\"\204\205\037\235\215\252V\220\026\3328Z\f\204]\323\356yp\362\233\212\303^\226\240\227\000\033\373:I1\331y\031\257\236\274`\020_F&De\f\200m\213\347\323\241iLC\345o\351\020\364\017#\275P\237P\351^\323\274\273Ync\200\255\275\373\276\376\206\273\210\351\365M\b\001\374+\321Xo>\304\364\363Gg\022\235\374RY6\223E_I\244\345\236\003\335\023\031\t\303\346\376!\302\376Sh\205\270\001\312\020\321\344\374\266\307uq<\f\244\272\a\302\261\237\000\205\355m\b\236(}YW\356c\265\346\032[\000K\234\352\323RW?g\340\021\230\305\227HY\262\374\376\237\263d\335\277\316\f?\251\002\332\370\177\030!\350\234#\267\353yNo\027*\260IM\240\n? \327\022V\343sH\304OE\220\2213\2076[\255\304\275:\260\327}\313\232\364\177/V8\210\256\003\237\311]\306\2735\352ye=\204\034{v\261\2269\367\222\313\356b9(\354]\344N3\270\333yQlo\003\341\206\034\306\254~\217Ep\353\034\022h\025\351*\033[\252\350\331v\315\036J2\"\244\031c\346_d\024\211qj\341`\343=7\017\240\255s&\262\336J\222\020\344\262P}\274s\034\024\271-z\274Nn\333y_\364^T\331m\246\v\247W\'.=\254\376\2648\274\032\vA\026\027\366\002\3361\375l%i)\033\005\345M%$3d\2550\315W8\314\353\002[\317\277\320\346\017\023h\035\346\250\355\236[E\324\002\321\017\343\253\347!5\274B\331\304\226A\222\210l\364S\026\002j\371Du\2215\034\251\033|\362\016g\330\213\341\370\234<\372r\360\361\203`\334\253\374\207\302\026\2535W\025\355\251\331\316\257G\310\334\250w?\t\334%\375\373\214^\373\231_\347\356A\250VT\300\305\v\332cbt\fp\\\3307\255{\346\370J\337\350\2567\340\242s\377\217\0319_8\246\020\345d\226\350X\317\327O\330p\033\361\343n`\257\211\353G\277/\312o\216\322\201\260{,\016\375\301r@\256\261\264\372L\f\315#\220\343\221\374\220D\302\034x!\321\242W\214!i\257`\346\303\247\245\001\234\375P\377J\036)\016N\022\271>\037(SN\0350\236\177\373T\272\372\000^\037=\023\260\0207DF\225R\211P\324\237\210\023,E\032\317\263\343\027]\246}K\'\261<\345\266\240\237\342\016\002\326\311\340w>\030\036\317Sx\304b8A\227\336\355P\236c\304\346\353\302\r\0220\255z\337\215\210o\354\267\232~?\az\'\035O9n\335\330L\346%\210-s\342\345\'\220"
