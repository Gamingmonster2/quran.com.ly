    content: "    document.body.removeChild(link);\n  };\n\n  const codeSnippets: Record<string, string> = {\n    javascript: `// \330\247\330\263\330\252\331\212\330\261\330\247\330\257 \331\210\331\202\330\261\330\247\330\241\330\251 \331\205\331\204\331\201 \330\247\331\204\331\202\330\261\330\242\331\206 \330\247\331\204\331\203\330\261\331\212\331\205 \331\201\331\212 Node.js / TypeScript\nimport fs from \'node:fs\';\n\ninterface Ayah {\n  sura: number; // 1 - 114\n  aya: number;  // 1 - n\n  text: string; // \330\247\331\204\330\261\330\263\331\205 \330\247\331\204\330\271\330\253\331\205\330\247\331\206\331\212\n}\n\nconst quranData: Ayah[] = JSON.parse(\n  fs.readFileSync(\'./assets/data/quran.json\', \'utf-8\')\n);\n\nconsole.log(\\`\330\245\330\254\331\205\330\247\331\204\331\212 \330\247\331\204\330\242\331\212\330\247\330\252: \\${quranData.length}\\`); // 6236\nconst firstAyah = quranData[0];\nconsole.log(firstAyah.text); // \330\250\331\220\330\263\333\241\331\205\331\220 \331\261\331\204\331\204\331\221\331\216\331\207\331\220 \331\261\331\204\330\261\331\221\331\216\330\255\333\241\331\205\331\216\331\260\331\206\331\220 \331\261\331\204\330\261\331\221\331\216\330\255\331\220\331\212\331\205\331\220`,\n\n    python: `# \331\202\330\261\330\247\330\241\330\251 \331\205\331\204\331\201 \330\247\331\204\331\202\330\261\330\242\331\206 \330\247\331\204\331\203\330\261\331\212\331\205 \331\201\331\212 Python\nimport json\n\nwith open(\'./assets/data/quran.json\', \'r\', encoding=\'utf-8\') as f:\n    quran = json.load(f)\n\nprint(f\"\330\245\330\254\331\205\330\247\331\204\331\212 \330\247\331\204\330\242\331\212\330\247\330\252: {len(quran)}\") # 6236\n# \330\252\330\265\331\201\331\212\330\251 \330\242\331\212\330\247\330\252 \330\263\331\210\330\261\330\251 \330\247\331\204\330\245\330\256\331\204\330\247\330\265 (\330\261\331\202\331\205 112)\nikhlas_ayahs = [v for v in quran if v[\'sura\'] == 112]\nfor ayah in ikhlas_ayahs:\n    print(f\"{ayah[\'aya\']}: {ayah[\'text\']}\")`,\n\n    curl: `# \330\252\331\206\330\262\331\212\331\204 \331\205\331\204\331\201 \330\247\331\204\331\202\330\261\330\242\331\206 \330\247\331\204\331\203\330\261\331\212\331\205 \330\247\331\204\330\264\330\247\331\205\331\204 \331\205\330\250\330\247\330\264\330\261\330\251\ncurl -O https://cdn.jsdelivr.net/npm/quran-json@3.1.2/dist/quran.json\n\n# \330\243\331\210 \330\247\331\204\331\210\330\265\331\210\331\204 \331\204\331\204\331\205\331\204\331\201 \330\247\331\204\331\205\330\255\331\204\331\212 \331\205\331\206 \331\205\330\263\330\247\330\261 \330\247\331\204\330\252\330\267\330\250\331\212\331\202:\n# assets/data/quran.json`\n  };\n\n  const handleCopyCode = async () => {\n    await navigator.clipboard.writeText(codeSnippets[codeLang]);\n    setCopiedCode(true);\n    setTimeout(() => setCopiedCode(false), 2000);\n  };\n\n  const content = (\n    <div className=\"space-y-6 text-right\">\n      {/* Title & Stats */}\n      <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-4 border-b border-stone-200\">\n        <div className=\"flex items-center gap-3\">"
