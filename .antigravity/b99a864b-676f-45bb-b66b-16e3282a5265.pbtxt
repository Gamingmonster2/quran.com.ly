    command_line: "node -e \'\nasync function test() {\n  const risanRes = await fetch(\"https://unpkg.com/quran-json@3.1.2/dist/quran.json\");\n  const risanData = await risanRes.json();\n  console.log(\"Risan total surahs:\", risanData.length);\n  let totalVerses = 0;\n  risanData.forEach(s => totalVerses += s.verses.length);\n  console.log(\"Risan total verses:\", totalVerses);\n  console.log(\"Risan Surah 1 Verse 1:\", JSON.stringify(risanData[0].verses[0]));\n  console.log(\"Risan Surah 2 Verse 1:\", JSON.stringify(risanData[1].verses[0]));\n  console.log(\"Risan Surah 114 Verse 6:\", JSON.stringify(risanData[113].verses[risanData[113].verses.length - 1]));\n}\ntest();\n\'"
    proposed_command_line: "node -e \'\nasync function test() {\n  const risanRes = await fetch(\"https://unpkg.com/quran-json@3.1.2/dist/quran.json\");\n  const risanData = await risanRes.json();\n  console.log(\"Risan total surahs:\", risanData.length);\n  let totalVerses = 0;\n  risanData.forEach(s => totalVerses += s.verses.length);\n  console.log(\"Risan total verses:\", totalVerses);\n  console.log(\"Risan Surah 1 Verse 1:\", JSON.stringify(risanData[0].verses[0]));\n  console.log(\"Risan Surah 2 Verse 1:\", JSON.stringify(risanData[1].verses[0]));\n  console.log(\"Risan Surah 114 Verse 6:\", JSON.stringify(risanData[113].verses[risanData[113].verses.length - 1]));\n}\ntest();\n\'"
