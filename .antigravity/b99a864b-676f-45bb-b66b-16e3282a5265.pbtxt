    combined_output {
      full: "Downloading UthmanTahaNaskh.ttf from https://cdn.jsdelivr.net/gh/fawazahmed0/quran-api@1/fonts/uthman-tn1-ver10.ttf...Downloaded UthmanTahaNaskh.ttf: 152312 bytes.Downloading UthmanTahaNaskh-Bold.ttf from https://cdn.jsdelivr.net/gh/fawazahmed0/quran-api@1/fonts/uthman-tn1-b-ver10.ttf...Downloaded UthmanTahaNaskh-Bold.ttf: 174764 bytes.Downloading KFGQPC-Hafs-v18.ttf from https://raw.githubusercontent.com/thetruetruth/quran-data-kfgqpc/main/hafs/font/hafs.18.ttf...Downloaded KFGQPC-Hafs-v18.ttf: 242368 bytes.All fonts downloaded and saved successfully!"
    }
    command_line: "node -e \'\nimport fs from \"node:fs\";\nimport path from \"node:path\";\n\nasync function downloadFonts() {\n  const fonts = [\n    {\n      name: \"UthmanTahaNaskh.ttf\",\n      url: \"https://cdn.jsdelivr.net/gh/fawazahmed0/quran-api@1/fonts/uthman-tn1-ver10.ttf\"\n    },\n    {\n      name: \"UthmanTahaNaskh-Bold.ttf\",\n      url: \"https://cdn.jsdelivr.net/gh/fawazahmed0/quran-api@1/fonts/uthman-tn1-b-ver10.ttf\"\n    },\n    {\n      name: \"KFGQPC-Hafs-v18.ttf\",\n      url: \"https://raw.githubusercontent.com/thetruetruth/quran-data-kfgqpc/main/hafs/font/hafs.18.ttf\"\n    }\n  ];\n\n  const targetDirs = [\n    path.resolve(\"assets/fonts\"),\n    path.resolve(\"public/assets/fonts\"),\n    path.resolve(\"src/assets/fonts\")\n  ];\n\n  for (const dir of targetDirs) {\n    fs.mkdirSync(dir, { recursive: true });\n  }\n\n  for (const font of fonts) {\n    console.log(`Downloading ${font.name} from ${font.url}...`);\n    const res = await fetch(font.url);\n    if (!res.ok) throw new Error(`Failed to download ${font.name}: ${res.statusText}`);\n    const buffer = Buffer.from(await res.arrayBuffer());\n    console.log(`Downloaded ${font.name}: ${buffer.byteLength} bytes.`);\n\n    for (const dir of targetDirs) {\n      fs.writeFileSync(path.join(dir, font.name), buffer);\n    }\n  }\n\n  console.log(\"All fonts downloaded and saved successfully!\");\n}\n\ndownloadFonts().catch(err => {\n  console.error(err);\n  process.exit(1);\n});\n\'"
    proposed_command_line: "node -e \'\nimport fs from \"node:fs\";\nimport path from \"node:path\";\n\nasync function downloadFonts() {\n  const fonts = [\n    {\n      name: \"UthmanTahaNaskh.ttf\",\n      url: \"https://cdn.jsdelivr.net/gh/fawazahmed0/quran-api@1/fonts/uthman-tn1-ver10.ttf\"\n    },\n    {\n      name: \"UthmanTahaNaskh-Bold.ttf\",\n      url: \"https://cdn.jsdelivr.net/gh/fawazahmed0/quran-api@1/fonts/uthman-tn1-b-ver10.ttf\"\n    },\n    {\n      name: \"KFGQPC-Hafs-v18.ttf\",\n      url: \"https://raw.githubusercontent.com/thetruetruth/quran-data-kfgqpc/main/hafs/font/hafs.18.ttf\"\n    }\n  ];\n\n  const targetDirs = [\n    path.resolve(\"assets/fonts\"),\n    path.resolve(\"public/assets/fonts\"),\n    path.resolve(\"src/assets/fonts\")\n  ];\n\n  for (const dir of targetDirs) {\n    fs.mkdirSync(dir, { recursive: true });\n  }\n\n  for (const font of fonts) {\n    console.log(`Downloading ${font.name} from ${font.url}...`);\n    const res = await fetch(font.url);\n    if (!res.ok) throw new Error(`Failed to download ${font.name}: ${res.statusText}`);\n    const buffer = Buffer.from(await res.arrayBuffer());\n    console.log(`Downloaded ${font.name}: ${buffer.byteLength} bytes.`);\n\n    for (const dir of targetDirs) {\n      fs.writeFileSync(path.join(dir, font.name), buffer);\n    }\n  }\n\n  console.log(\"All fonts downloaded and saved successfully!\");\n}\n\ndownloadFonts().catch(err => {\n  console.error(err);\n  process.exit(1);\n});\n\'"
    shell_name: "bash"
  }
