{
  "id": 112,
  "name": "الإخلاص",
  "transliteration": "Al-Ikhlas",
  "type": "meccan",
  "total_verses": 4,
  "verses": [
    {
      "sura": 112,
      "aya": 1,
      "text": "قُلۡ هُوَ ٱللَّهُ أَحَدٌ"
    },
    {
      "sura": 112,
      "aya": 2,
      "text": "ٱللَّهُ ٱلصَّمَدُ"
    },
    {
      "sura": 112,
      "aya": 3,
      "text": "لَمۡ يَلِدۡ وَلَمۡ يُولَدۡ"
    },
    {
      "sura": 112,
      "aya": 4,
      "text": "وَلَمۡ يَكُن لَّهُۥ كُفُوًا أَحَدُۢ"
    }
  ]
}