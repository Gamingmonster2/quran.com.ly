{"surahId":91,"language":"en","words":[{"aya":1,"entries":[{"position":1,"text":"وَٱلشَّمْسِ","translation":"By the sun","transliteration":"wal-shamsi"},{"position":2,"text":"وَضُحَىٰهَا","translation":"and its brightness","transliteration":"waḍuḥāhā"}]},{"aya":2,"entries":[{"position":1,"text":"وَٱلْقَمَرِ","translation":"And the moon","transliteration":"wal-qamari"},{"position":2,"text":"إِذَا","translation":"when","transliteration":"idhā"},{"position":3,"text":"تَلَىٰهَا","translation":"it follows it","transliteration":"talāhā"}]},{"aya":3,"entries":[{"position":1,"text":"وَٱلنَّهَارِ","translation":"And the day","transliteration":"wal-nahāri"},{"position":2,"text":"إِذَا","translation":"when","transliteration":"idhā"},{"position":3,"text":"جَلَّىٰهَا","translation":"it displays it","transliteration":"jallāhā"}]},{"aya":4,"entries":[{"position":1,"text":"وَٱلَّيْلِ","translation":"And the night","transliteration":"wa-al-layli"},{"position":2,"text":"إِذَا","translation":"when","transliteration":"idhā"},{"position":3,"text":"يَغْشَىٰهَا","translation":"it covers it","transliteration":"yaghshāhā"}]},{"aya":5,"entries":[{"position":1,"text":"وَٱلسَّمَآءِ","translation":"And the heaven","transliteration":"wal-samāi"},{"position":2,"text":"وَمَا","translation":"and (He) Who","transliteration":"wamā"},{"position":3,"text":"بَنَىٰهَا","translation":"constructed it","transliteration":"banāhā"}]},{"aya":6,"entries":[{"position":1,"text":"وَٱلْأَرْضِ","translation":"And the earth","transliteration":"wal-arḍi"},{"position":2,"text":"وَمَا","translation":"and by (He) Who","transliteration":"wamā"},{"position":3,"text":"طَحَىٰهَا","translation":"spread it","transliteration":"ṭaḥāhā"}]},{"aya":7,"entries":[{"position":1,"text":"وَنَفْسٍۢ","translation":"And (the) soul","transliteration":"wanafsin"},{"position":2,"text":"وَمَا","translation":"and (He) Who","transliteration":"wamā"},{"position":3,"text":"سَوَّىٰهَا","translation":"proportioned it","transliteration":"sawwāhā"}]},{"aya":8,"entries":[{"position":1,"text":"فَأَلْهَمَهَا","translation":"And He inspired it","transliteration":"fa-alhamahā"},{"position":2,"text":"فُجُورَهَا","translation":"(to distinguish) its wickedness","transliteration":"fujūrahā"},{"position":3,"text":"وَتَقْوَىٰهَا","translation":"and its righteousness","transliteration":"wataqwāhā"}]},{"aya":9,"entries":[{"position":1,"text":"قَدْ","translation":"Indeed","transliteration":"qad"},{"position":2,"text":"أَفْلَحَ","translation":"he succeeds","transliteration":"aflaḥa"},{"position":3,"text":"مَن","translation":"who","transliteration":"man"},{"position":4,"text":"زَكَّىٰهَا","translation":"purifies it","transliteration":"zakkāhā"}]},{"aya":10,"entries":[{"position":1,"text":"وَقَدْ","translation":"And indeed","transliteration":"waqad"},{"position":2,"text":"خَابَ","translation":"he fails","transliteration":"khāba"},{"position":3,"text":"مَن","translation":"who","transliteration":"man"},{"position":4,"text":"دَسَّىٰهَا","translation":"buries it","transliteration":"dassāhā"}]},{"aya":11,"entries":[{"position":1,"text":"كَذَّبَتْ","translation":"Denied","transliteration":"kadhabat"},{"position":2,"text":"ثَمُودُ","translation":"Thamud","transliteration":"thamūdu"},{"position":3,"text":"بِطَغْوَىٰهَآ","translation":"by their transgression","transliteration":"biṭaghwāhā"}]},{"aya":12,"entries":[{"position":1,"text":"إِذِ","translation":"When","transliteration":"idhi"},{"position":2,"text":"ٱنۢبَعَثَ","translation":"(was) sent forth","transliteration":"inbaʿatha"},{"position":3,"text":"أَشْقَىٰهَا","translation":"(the) most wicked of them","transliteration":"ashqāhā"}]},{"aya":13,"entries":[{"position":1,"text":"فَقَالَ","translation":"But said","transliteration":"faqāla"},{"position":2,"text":"لَهُمْ","translation":"to them","transliteration":"lahum"},{"position":3,"text":"رَسُولُ","translation":"(the) Messenger","transliteration":"rasūlu"},{"position":4,"text":"ٱللَّهِ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":5,"text":"نَاقَةَ","translation":"(It is the) she-camel","transliteration":"nāqata"},{"position":6,"text":"ٱللَّهِ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":7,"text":"وَسُقْيَـٰهَا","translation":"and her drink","transliteration":"wasuq'yāhā"}]},{"aya":14,"entries":[{"position":1,"text":"فَكَذَّبُوهُ","translation":"But they denied him","transliteration":"fakadhabūhu"},{"position":2,"text":"فَعَقَرُوهَا","translation":"and they hamstrung her","transliteration":"faʿaqarūhā"},{"position":3,"text":"فَدَمْدَمَ","translation":"So destroyed","transliteration":"fadamdama"},{"position":4,"text":"عَلَيْهِمْ","translation":"them","transliteration":"ʿalayhim"},{"position":5,"text":"رَبُّهُم","translation":"their Lord","transliteration":"rabbuhum"},{"position":6,"text":"بِذَنۢبِهِمْ","translation":"for their sin","transliteration":"bidhanbihim"},{"position":7,"text":"فَسَوَّىٰهَا","translation":"and leveled them","transliteration":"fasawwāhā"}]},{"aya":15,"entries":[{"position":1,"text":"وَلَا","translation":"And not","transliteration":"walā"},{"position":2,"text":"يَخَافُ","translation":"He fears","transliteration":"yakhāfu"},{"position":3,"text":"عُقْبَـٰهَا","translation":"its consequences","transliteration":"ʿuq'bāhā"}]}]}